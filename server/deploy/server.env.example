# /etc/rofront/server.env  (root:root, mode 600). Never commit the real file.
FRONTLINE_PORT=8070
FRONTLINE_DEFAULT_BOTS=40
# 1 = ranked match: accounts only, rated through the account service. Speed is capped to 1x-2x.
FRONTLINE_RANKED=1
FRONTLINE_SPEED_CAP=1
# the same INTERNAL_KEY the account service uses; without it the server accepts anybody and reports nothing
INTERNAL_KEY=
FRONTLINE_API=http://127.0.0.1:8071/api/v1
# Match type: ffa (default), teams, or mixed (alternates). Team matches have no bot players (tribes only), the team
# size is random (Duos / Trios / Quads) and the match waits for FRONTLINE_TEAM_PLAYERS people (4-12; teams are made
# when they are all in, or after 60 s with at least 2).
FRONTLINE_MODE=ffa
FRONTLINE_TEAM_PLAYERS=6

# Owner console (accounts service env, not the game server): the account that may get a console token, and its signing key
# ADMIN_USERS=henry9149
# ADMIN_KEY_FILE=/etc/frontline/console_private.pem

# Waiting room length in seconds (default 60; 5-600).
#FRONTLINE_LOBBY_SECS=60
